    "rehype-unwrap-images": "^1.0.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tiny-invariant": "^1.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
